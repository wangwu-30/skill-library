# Control-plane repository for the local skill system.
# Track local governance and house skills; ignore mirrored upstream repos and generated outputs.

/*

!/.gitignore
!/Agent.md
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/CONTRIBUTING.md
!/SECURITY.md
!/uv.lock
!/pyproject.toml
!/README.md
!/.github/
!/.github/**
!/.cursor/
!/.cursor/rules/
!/.cursor/rules/**
!/.githooks/
!/.githooks/**
!/.agents/
!/.agents/workflows/
!/.agents/workflows/**
!/examples/
!/examples/**
!/house-skills/
!/house-skills/**
!/docs/
!/docs/**
!/eval/
!/eval/**
!/tests/
!/tests/**
!/catalog/

/catalog/*
!/catalog/tracked_repos.json
!/catalog/tracked_repos.lock.json
!/catalog/reviewed_core.lock.json
!/catalog/blacklisted_repos.json

/CATALOG.md
/memory.md
/catalog/skill_catalog.json
/catalog/daily_skill_watch_last.json

__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
.skill-library.lock
